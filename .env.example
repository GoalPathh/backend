PORT=4000
FRONTEND_URL=http://localhost:3000

# ── MySQL Database (XAMPP / Local) ────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/goalpath"

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Development only UUID fallback (opsional)
DEFAULT_USER_ID=

# ── AI Provider Configuration ────────────────────────────────────────────────
# Choose your driver:  "raw" (default)  or  "vercel"
LLM_DRIVER=raw
LLM_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-3.1-flash-lite

# Cloudinary signed uploads for profile avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=goalpath/avatars

# Midtrans payment gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
PREMIUM_PRICE_IDR=150000
PREMIUM_PERIOD_DAYS=30
